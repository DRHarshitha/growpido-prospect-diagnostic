# Required when public-web research is implemented.
TAVILY_API_KEY=

# Local extraction is the default and needs no OpenAI API key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Optional OpenAI fallback, used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

